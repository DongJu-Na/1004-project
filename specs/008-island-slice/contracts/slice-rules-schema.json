{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SliceRules",
  "type": "object",
  "required": ["version", "clock", "evidence", "restricted", "dock", "vehicle", "objectives", "hints", "hintSeconds", "feedback"],
  "properties": {
    "version": { "type": "string" },
    "clock": { "type": "object", "required": ["nightAtSeconds", "departureAtSeconds", "nextBoatDelaySeconds", "status"], "properties": { "nightAtSeconds": { "type": "number", "exclusiveMinimum": 0 }, "departureAtSeconds": { "type": "number", "exclusiveMinimum": 0 }, "nextBoatDelaySeconds": { "type": "number", "exclusiveMinimum": 0 }, "status": { "enum": ["확정", "확정대기"] } } },
    "evidence": { "type": "object", "required": ["investigateSeconds", "twoHanded", "seenCooldownSeconds", "oneHandEventId", "twoHandEventId", "status"] },
    "restricted": { "type": "object", "required": ["cooldownSeconds", "eventId", "status"] },
    "dock": { "type": "object", "required": ["boardRadius", "requireEvidenceForSuccess", "status"] },
    "vehicle": { "type": "object", "required": ["allowEvidenceAboard"] },
    "objectives": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "text", "markerFacilityId", "condition"], "properties": { "condition": { "enum": ["evidence_picked", "at_dock_with_evidence"] } } } },
    "hints": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "hintSeconds": { "type": "number", "exclusiveMinimum": 0 },
    "feedback": {
      "type": "object", "required": ["heartbeat", "pulse", "tint", "hitstop", "shake", "bigText"],
      "properties": {
        "heartbeat": { "type": "object", "required": ["intervalsByStage", "zoneMultiplier", "volume"], "properties": { "intervalsByStage": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number", "exclusiveMinimum": 0 } }, "zoneMultiplier": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number", "exclusiveMinimum": 0 } }, "volume": { "type": "number", "minimum": 0, "maximum": 1 } } },
        "pulse": { "type": "object", "required": ["seconds", "alpha"] },
        "tint": { "type": "object", "required": ["alphaByZone", "nightAlpha"] },
        "hitstop": { "type": "object", "required": ["seconds"] },
        "shake": { "type": "object", "required": ["amplitude", "seconds"] },
        "bigText": { "type": "object", "required": ["seconds"] }
      }
    }
  }
}
